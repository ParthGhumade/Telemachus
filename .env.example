# Google Gemini / GenAI API Key (Required)
gemini_api_key=your_gemini_api_key_here
# Alternative environment variable name:
# GOOGLE_API_KEY=your_gemini_api_key_here

# LLM & Embedding Model Configurations
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Google Drive Dataset Auto-Download (used in Docker Compose)
# Provide either the public sharing URL or direct file ID of dataset.zip
# DATASET_DRIVE_URL=https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing
# DATASET_DRIVE_ID=YOUR_FILE_ID

# Dataset & Document Directories (Relative to project root or absolute paths)
# DOCS_DIR=backend/dataset/docs
# PARQUET_DIR=backend/dataset/parquet

# Storage & Database Paths
CHROMA_PERSIST_DIR=db/chroma_db_gemini
DUCKDB_PATH=backend/telemachus.duckdb
